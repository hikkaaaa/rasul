# Copy to `.env` and edit. Do NOT commit the real .env file.

# SQLAlchemy URL. Use postgresql://user:pass@host:5432/dbname in production.
DATABASE_URL=sqlite:///./face_system.db

# JSON list of allowed frontend origins for CORS.
CORS_ORIGINS=["http://localhost:5173"]

# Face match distance threshold. Lower = stricter. Typical range 0.5–0.6.
# 0.5 is the stricter end — reduces false positives on a small user base.
FACE_TOLERANCE=0.5

# Signup rejects if the new face is closer than this to any existing user.
DUPLICATE_FACE_DISTANCE=0.45

# slowapi rate limits (see https://slowapi.readthedocs.io/).
LOGIN_RATE_LIMIT=5/minute
SIGNUP_RATE_LIMIT=10/hour

# Max decoded image size in bytes (5 MB default).
MAX_IMAGE_BYTES=5242880

# Minimum Laplacian variance on the face crop — rejects blurry / screen-replayed shots.
MIN_FACE_BLUR_VARIANCE=40.0

LOG_LEVEL=INFO
